# Required. From @BotFather.
BOT_TOKEN=

# Comma-separated Telegram user ids that may use /stats.
ADMIN_IDS=

# Telegram Bot API upload cap (MB). Qualities above this are flagged.
MAX_FILE_MB=50

# Per-user sliding-window limit for link/download actions.
RATE_LIMIT_PER_MIN=5

# Global cap on simultaneous yt-dlp jobs.
MAX_CONCURRENT_DOWNLOADS=3

# Temp downloads (cleaned after send). In Docker: /data/downloads
DOWNLOAD_DIR=./downloads

# SQLite database path. In Docker: /data/bot.db
DB_PATH=./data/bot.db

# Optional Netscape cookies.txt for Instagram (login / rate-limit).
# Leave empty if unused. Example: ./cookies/instagram.txt
IG_COOKIES_FILE=

# Default UI language: ru | en
DEFAULT_LANG=ru

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Heartbeat file for Docker healthcheck (mtime must stay fresh).
HEARTBEAT_PATH=/tmp/bot-heartbeat
